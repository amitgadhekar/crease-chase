{
  "name": "crease-chase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-file 3D cricket batting web game against an adaptive AI bowler.",
  "scripts": {
    "build": "node build.mjs",
    "test:balance": "node tests/balance.mjs",
    "test:smoke": "node build.mjs && node tests/smoke.mjs",
    "test": "npm run test:balance && npm run test:smoke",
    "lab": "BUILD_OUT=dist/lab.html node build.mjs && node tests/charlab.mjs",
    "test:motion": "node tests/motion.mjs",
    "model:batter": "node tools/model.mjs batter",
    "model:fielder": "node tools/model.mjs fielder"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "three": "0.186.1"
  }
}
